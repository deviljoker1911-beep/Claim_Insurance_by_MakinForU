# ClaimAI configuration. Copy to `.env` (`make env`) and adjust.

# --- App ---------------------------------------------------------------------
APP_ENV=development
# Demo mode: deterministic results for the bundled synthetic demo documents.
DEMO_MODE=true
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8010
FRONTEND_ORIGIN=http://127.0.0.1:5173
# Serve the built web app from the API process (`make demo` sets this for you).
SERVE_FRONTEND=false

# --- Database ------------------------------------------------------------------
# PostgreSQL in Docker (`make db-docker`, published on port 5433):
DATABASE_URL=postgresql+psycopg://claimai:claimai@127.0.0.1:5433/claimai
# Local PostgreSQL (e.g. Homebrew):
# DATABASE_URL=postgresql+psycopg://<your-user>@127.0.0.1:5432/claimai
# Zero-setup fallback (relative to backend/):
# DATABASE_URL=sqlite:///./storage/claimai.db

# --- Storage -------------------------------------------------------------------
# Uploaded originals (never modified), rendered pages and reports.
# Relative paths resolve against backend/.
STORAGE_DIR=./storage
# Synthetic demo documents and their manifest (regenerate with `make demo-data`).
# DEMO_DATA_DIR=../demo_data

# --- Claims and uploads --------------------------------------------------------
# Claim numbers are <CLAIM_SERIES>-<5-digit sequence>; a demo reset restarts the
# sequence at CLAIM_SEQUENCE_START, so the next new claim is CLM-2026-00123.
# CLAIM_SERIES=CLM-2026
# CLAIM_SEQUENCE_START=123
# MAX_UPLOAD_FILES=50
# MAX_UPLOAD_MB=25
# Name recorded on audit events until authentication exists.
# OPERATOR_NAME=Demo Operator

# --- Document intelligence ---------------------------------------------------------
# OCR engine order for pages that have no text layer:
#   auto         RapidOCR if installed, otherwise the labelled demo fixtures (default)
#   rapidocr     RapidOCR only (PP-OCR models bundled with the package; fully offline)
#   demo_fixture only the deterministic demo fixtures shipped with the demo documents
#   none         no OCR (scanned pages report that no text could be read)
# OCR_ENGINE=auto
# Pause between visible processing stages, in milliseconds, so a demo audience can follow
# the timeline. 0 runs at full speed; the demo target sets 120.
# DEMO_PACING_MS=0

# --- Access gate -----------------------------------------------------------------
# Ask every visitor for an email address before anything else answers. Off for local
# development; a public deployment turns it on. See "The access gate" in the README.
# ACCESS_GATE_ENABLED=false
# Signs the session cookie. Required when the gate is on; the app refuses to start without
# it rather than signing with something guessable. Generate: openssl rand -hex 32
# ACCESS_SESSION_SECRET=
# Reads the captured list at GET /api/access/visitors, with an X-Admin-Token header.
# Leave empty and that endpoint is not served at all.
# ACCESS_ADMIN_TOKEN=
# Emailed the first time each visitor proves an address. Comma-separated; needs SMTP.
# ACCESS_SIGNUP_ALERT_TO=
# How long a session lasts, how long a code lasts, and how many tries it is worth.
# ACCESS_SESSION_DAYS=30
# ACCESS_CODE_TTL_MINUTES=10
# ACCESS_CODE_MAX_ATTEMPTS=5
# Caps on an endpoint that sends mail to whatever address it is handed.
# ACCESS_REQUESTS_PER_EMAIL_PER_HOUR=5
# ACCESS_REQUESTS_PER_IP_PER_HOUR=20

# --- Mail ------------------------------------------------------------------------
# Where access codes are sent from. With SMTP_HOST empty the code is written to the
# application log instead and the screen says so, so the gate still works offline.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USERNAME=
# SMTP_PASSWORD=
# SMTP_FROM=ClaimAI <noreply@example.com>
# SMTP_STARTTLS=true

# --- AI provider -----------------------------------------------------------------
# demo      = offline deterministic engine (no API key needed)
# anthropic = Anthropic Claude
# openai    = any OpenAI-compatible API (set OPENAI_BASE_URL for Azure, Ollama, vLLM, ...)
LLM_PROVIDER=demo
# Empty = provider default (anthropic: claude-opus-5). Required for openai.
LLM_MODEL=
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
