# Copy to .env.prod next to docker-compose.prod.yml and fill in. Nothing here has a default
# that would be safe to ship, which is why the compose file refuses to start without them.

# The name you are hosting on. An A record for it must already point at this server.
CLAIMAI_DOMAIN=claimai.makinforu.com

# The database password. Used by both the database and the app.
POSTGRES_PASSWORD=

# Signs the access session cookie. Generate with: openssl rand -hex 32
# Changing it signs everyone out, which is the only way to revoke a session.
ACCESS_SESSION_SECRET=

# Anyone may enter an email address and come in; ACCESS_GATE_ENABLED=false opens it to everyone.
ACCESS_GATE_ENABLED=true

# Reads the list of addresses that have asked for access:
#   curl -H "X-Admin-Token: <this>" https://<domain>/api/access/visitors
# Leave empty and that endpoint is not served at all.
ACCESS_ADMIN_TOKEN=

# Emailed the first time each visitor proves an address, with a reply that goes to them.
# Comma-separated for more than one. Needs SMTP below; leave empty for no alerts.
ACCESS_SIGNUP_ALERT_TO=

# Where the six-digit codes are sent from. With SMTP_HOST empty the code is written to the
# container log instead (docker compose logs app) — the gate still works, by hand.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_FROM=ClaimAI <noreply@makinforu.com>

# Slows the visible processing stages so an audience can follow them. 0 runs at full speed.
DEMO_PACING_MS=120
